# Copy this file to .env and fill in the values.
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# MongoDB (required for RSVP, donations, and Gift Wall)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/wedding

# Paystack — required for donation/payment features
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
# The URL Paystack redirects to after payment. Must be whitelisted in your Paystack dashboard.
PAYSTACK_CALLBACK_URL=https://your-frontend-domain.vercel.app/gift/callback
